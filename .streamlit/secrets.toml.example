# Template for Streamlit secrets.
#
# LOCAL: you don't need this file -- use .env instead.
# STREAMLIT CLOUD: copy these keys into
#   App -> Settings -> Secrets  (paste the contents, with your real values).
#
# Do NOT commit a real secrets.toml with your key -- it is git-ignored.

GOOGLE_API_KEY = "your_google_api_key_here"
GEN_MODEL = "gemini-3.1-flash-lite"
EMBED_MODEL = "gemini-embedding-001"
